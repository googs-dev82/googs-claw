{
  "name": "claudeclaw",
  "version": "2.0.0",
  "type": "module",
  "scripts": {
    "build": "tsc",
    "start": "node dist/src/index.js",
    "dev": "tsx src/index.ts",
    "setup": "tsx src/setup.ts",
    "status": "tsx src/status.ts",
    "doctor": "tsx src/doctor.ts",
    "backup": "tsx src/backup-cli.ts backup",
    "backup:list": "tsx src/backup-cli.ts list",
    "restore": "tsx src/backup-cli.ts restore",
    "agent:create": "tsx src/agent-cli.ts",
    "agent:start": "tsx src/index.ts",
    "mission": "tsx src/mission-cli.ts",
    "meet": "tsx src/meet-cli.ts",
    "schedule": "tsx src/schedule-cli.ts",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "warroom": "python3 warroom/warroom_pipecat.py",
    "dashboard": "tsx src/dashboard.ts"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "@anthropic-ai/claude-agent-sdk": "^0.2.34",
    "@google/genai": "^1.44.0",
    "@hono/node-server": "^1.13.0",
    "@slack/bolt": "^4.7.1",
    "@types/qrcode-terminal": "^0.12.2",
    "better-sqlite3": "^11.7.0",
    "cron-parser": "^4.9.0",
    "grammy": "^1.32.0",
    "hono": "^4.7.0",
    "js-yaml": "^4.1.0",
    "pino": "^9.6.0",
    "pino-pretty": "^12.0.0",
    "qrcode-terminal": "^0.12.0",
    "whatsapp-web.js": "^1.26.0"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.12",
    "@types/js-yaml": "^4.0.9",
    "@types/node": "^22.10.0",
    "tsx": "^4.19.0",
    "typescript": "^5.7.0",
    "vitest": "^2.1.0"
  }
}
