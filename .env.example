# ClaudeClaw local test configuration

# Telegram: create this with @BotFather.
TELEGRAM_BOT_TOKEN=

# Recommended: your numeric private-chat Telegram ID.
# If empty, anyone who finds the bot can message it.
ALLOWED_TELEGRAM_IDS=

# LLM runtime.
# claude = local Claude Code CLI / Anthropic Claude Code SDK with tools.
# ollama = local Ollama chat model, no Claude Code tools.
# openrouter = OpenRouter chat model, no Claude Code tools.
LLM_PROVIDER=claude

# Claude provider.
# Leave ANTHROPIC_API_KEY empty if your local `claude` CLI is already logged in.
ANTHROPIC_API_KEY=
DEFAULT_MODEL=claude-sonnet-4-6
AGENT_MAX_TURNS=30
AGENT_TIMEOUT_MS=900000

# Ollama provider.
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=gemma3:4b

# OpenRouter provider.
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_MODEL=openrouter/free
OPENROUTER_SITE_URL=http://localhost:3141
OPENROUTER_APP_NAME=ClaudeClaw

# Google Calendar provider for meeting scheduling.
# If access token is not set, the app can refresh it with the refresh token flow.
GOOGLE_CALENDAR_ID=primary
GOOGLE_CALENDAR_TIMEZONE=Asia/Riyadh
GOOGLE_CALENDAR_ACCESS_TOKEN=
GOOGLE_CALENDAR_REFRESH_TOKEN=
GOOGLE_CALENDAR_CLIENT_ID=
GOOGLE_CALENDAR_CLIENT_SECRET=

# Tool layer for openrouter/ollama providers.
# LS, Read, and Grep are enabled when PROVIDER_TOOLS_ENABLED=true.
# Bash and Edit are separate opt-ins because Telegram becomes a remote control.
PROVIDER_TOOLS_ENABLED=true
TOOL_ROOT=.
TOOL_ALLOW_BASH=false
TOOL_ALLOW_EDIT=false
TOOL_TIMEOUT_MS=30000
TOOL_MAX_LOOPS=5

# Keep the first Telegram test quiet and predictable.
DASHBOARD_ENABLED=true
DASHBOARD_PORT=3141
SCHEDULER_ENABLED=false
MEMORY_EXTRACTION_ENABLED=false
MEMORY_CONSOLIDATION_ENABLED=false
MEMORY_DECAY_ENABLED=false
WHATSAPP_ENABLED=false
SLACK_ENABLED=false
WARROOM_ENABLED=false
VOICE_OUTPUT_ENABLED=false

# Optional later: enables Gemini memory extraction/embeddings.
GOOGLE_API_KEY=

# Optional later: voice input/output.
GROQ_API_KEY=
KOKORO_URL=http://localhost:5000
